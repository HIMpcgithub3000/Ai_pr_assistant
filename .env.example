# Application Environment Configuration
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
HOST=0.0.0.0

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_assistant
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pr_assistant
POSTGRES_PORT=5432

# Redis Broker & State Store
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# GitHub Integration
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=development_webhook_secret_12345
GITHUB_TOKEN=

# LLM Providers (OpenAI / Anthropic / Local)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=mock  # Options: mock, openai, anthropic (mock allows full local testing without API keys)

# OpenTelemetry / Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-pr-assistant

# Shared Clone Cache & Sandbox Settings
GIT_CACHE_DIR=./cache/git
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_IMAGE=python:3.11-slim
